{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Remote_2 (OpenOCD)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Remote_2.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "device": "STM32F103C8",
            "configFiles": [
                "${workspaceFolder}/openocd-horco.cfg",
                "target/stm32f1x.cfg"
            ],
            "openOCDPath": "/opt/homebrew/bin/openocd",
            "gdbPath": "/opt/homebrew/bin/arm-none-eabi-gdb",
            "preLaunchTask": "build",
            "runToEntryPoint": "main"
        },
        {
            "name": "Attach Remote_2 (OpenOCD)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Remote_2.elf",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "openocd",
            "device": "STM32F103C8",
            "configFiles": [
                "${workspaceFolder}/openocd-horco.cfg",
                "target/stm32f1x.cfg"
            ],
            "openOCDPath": "/opt/homebrew/bin/openocd",
            "gdbPath": "/opt/homebrew/bin/arm-none-eabi-gdb"
        }
    ]
}
