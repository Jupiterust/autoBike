$(BUILD_DIR)/%.o: %.c Makefile | $(BUILD_DIR) 
	$(CC) -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

$(BUILD_DIR)/%.o: %.s Makefile | $(BUILD_DIR)
	$(AS) -c $(CFLAGS) $< -o $@
$(BUILD_DIR)/%.o: %.S Makefile | $(BUILD_DIR)
	$(AS) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) Makefile
	$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	$(SZ) $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(HEX) $< $@
	
$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(BIN) $< $@	
	
$(BUILD_DIR):
	mkdir $@		

#######################################
# flash (Horco CMSIS-DAP probe: its v2/bulk channel never responds,
# so the hid backend is forced explicitly. The connect handshake over
# hid is also flaky -- fails intermittently in both wired and wireless
# mode -- but always before any flash write starts, so it's safe to
# just retry until it connects).
#######################################
flash: $(BUILD_DIR)/$(TARGET).elf
	@for i in 1 2 3 4 5 6 7 8; do \
		echo "--- flash attempt $$i ---"; \
		openocd -c "adapter driver cmsis-dap" -c "cmsis_dap_backend hid" -f target/stm32f4x.cfg -c "program $< verify reset exit" && exit 0; \
		sleep 2; \
	done; \
	echo "flash failed after 8 attempts"; exit 1

