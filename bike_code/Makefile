# compile gcc flags
ASFLAGS = $(MCU) $(AS_DEFS) $(AS_INCLUDES) $(OPT) -Wall -fdata-sections -ffunction-sections

# USER/*.c comments are GBK-encoded (Chinese); tell cpp so a stray GBK byte
# sequence ending in 0x5C in a comment isn't misread as a line continuation.
CFLAGS += $(MCU) $(C_DEFS) $(C_INCLUDES) $(OPT) -Wall -fdata-sections -ffunction-sections -finput-charset=GBK

