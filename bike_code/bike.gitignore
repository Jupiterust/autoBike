# 1. 编译输出目录（EIDE/STM32CubeCLT 编译产物）
cmake-build-*/          # CLion/EIDE 自动生成的编译目录（含 debug/release）
build/                  # 通用编译输出目录（EIDE 可能默认此目录）
Target/                 # EIDE 部分版本的目标文件目录
out/                    # 其他可能的输出目录

# 2. 编译中间文件与产物
*.o                     # 目标文件
*.elf                   # 可执行文件（调试用，如 remote.elf）
*.hex                   # 烧录文件
*.bin                   # 二进制烧录文件
*.map                   # 链接映射文件
*.lst                   # 汇编列表文件
*.d                     # 依赖文件
*.obj                   # Windows 下目标文件
*.exe                   #  Windows 下可执行文件（交叉编译无关）
*.lib                   # 静态库文件
*.a                     # 静态库文件
*.so                    # 动态库文件（嵌入式少见，按需保留）

# 3. IDE 配置文件（EIDE/CLion/STM32CubeIDE 等）
.idea/                  # CLion/IntelliJ 系列 IDE 配置
.cproject               # STM32CubeIDE 配置
.project                # STM32CubeIDE 配置
.settings/              # STM32CubeIDE 配置
.launch                 # STM32CubeIDE 调试配置
.DS_Store               # Mac 系统隐藏文件
Thumbs.db               # Windows 系统缩略图文件
*.swp                   # Vim 临时文件
*.swo                   # 调试日志文件
*.log                   # 编译日志文件

# 4. STM32Cube 相关自动生成文件（按需调整，若手动修改需保留）
MX/                     # CubeMX 自动生成的代码目录
Generated/              # 自动生成文件目录
*.ioc.backup            # CubeMX 项目备份文件
stm32f4xx_hal_msp.c      # 若为自动生成且不手动修改，可忽略（否则保留）

# 5. 缓存与临时文件
.cache/                  # 工具缓存目录
.tmp/                    # 临时文件目录
*.tmp                    # 单个临时文件
*.bak                    # 备份文件
*~                      # 编辑器备份文件

# 6. 其他冗余文件
.vscode/                 # VS Code 配置（若不用可忽略）
.nrf24l01/               # 模块临时测试目录（按需调整）
docs/                    # 文档目录（若无需追踪可忽略）